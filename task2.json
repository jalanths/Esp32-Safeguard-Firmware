    {
        "id": "df16679fc164b448",
        "type": "function",
        "z": "2c83cf574d285887",
        "name": "Check Day or Night",
        "func": "const currentHour = new Date().getHours();\nmsg.currentHour = currentHour;\nif (currentHour >= 18 || currentHour < 6) {\n    msg.isNight = true;\n    msg.timeStatus = \"Night Time\";\n} else {\n    msg.isNight = false;\n    msg.timeStatus = \"Day Time\";\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
