        "type": "function",
        "z": "2c83cf574d285887",
        "name": "Light Controller",
        "func": "if (msg.motion === true && msg.isNight === true) {\n    msg.payload = \"LIGHT ON\";\n} else {\n    msg.payload = \"LIGHT OFF\";\n}\nreturn msg;",
