        "type": "function",
        "z": "2c83cf574d285887",
        "name": "Simulate Motion",
        "func": "const motionDetected = Math.random() > 0.5;\nmsg.motion = motionDetected;\nif (motionDetected) {\n    msg.motionStatus = \"Motion Detected\";\n} else {\n    msg.motionStatus = \"No Motion\";\n}\nreturn msg;",
